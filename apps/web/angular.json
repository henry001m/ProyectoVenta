{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "kicks-insight-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ki",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": { "outputPath": "dist/kicks-insight-web", "index": "src/index.html", "main": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "assets": ["src/assets"], "styles": ["src/styles.scss", "node_modules/primeicons/primeicons.css", "node_modules/primeflex/primeflex.css"] },
          "configurations": { "production": { "budgets": [{ "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" }], "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true } },
          "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular-devkit/build-angular:dev-server", "configurations": { "production": { "buildTarget": "kicks-insight-web:build:production" }, "development": { "buildTarget": "kicks-insight-web:build:development" } }, "defaultConfiguration": "development" },
        "test": { "builder": "@angular-devkit/build-angular:karma", "options": { "polyfills": ["zone.js", "zone.js/testing"], "tsConfig": "tsconfig.spec.json", "assets": ["src/assets"], "styles": ["src/styles.scss"], "karmaConfig": "karma.conf.js" } }
      }
    }
  },
  "cli": { "analytics": false }
}

